{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "planeon.internal.observation-windows/v1",
 "title": "Exhaustive direct and indirect observation-window register of the R12 reader at one baseline revision (W04-7); removals per W07 candidate",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schemaVersion",
  "readerRepository",
  "baselineRevision",
  "enforcementContext",
  "candidateRevision",
  "inventory",
  "exhaustive",
  "windows"
 ],
 "properties": {
  "schemaVersion": {
   "const": "planeon.internal.observation-windows/v1"
  },
  "readerRepository": {
   "const": "mas-harness-conformance-labs"
  },
  "baselineRevision": {
   "type": "string",
   "pattern": "^[0-9a-f]{40}$"
  },
  "enforcementContext": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "r10Revision",
    "harnessOnionRevision"
   ],
   "properties": {
    "r10Revision": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$"
    },
    "harnessOnionRevision": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$"
    }
   }
  },
  "candidateRevision": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[0-9a-f]{40}$"
  },
  "inventory": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "generator",
    "generatorSha256",
    "boundaries"
   ],
   "properties": {
    "generator": {
     "type": "string",
     "minLength": 1
    },
    "generatorSha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "boundaries": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "minItems": 1,
     "uniqueItems": true
    }
   }
  },
  "exhaustive": {
   "const": true
  },
  "windows": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "kind",
     "boundary",
     "parentWindow",
     "observationCall",
     "nestedChecks",
     "protectedFacts",
     "tracePosition",
     "autonomousEventLatency",
     "obligations",
     "tests",
     "removal"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^OW-[0-9]{2,3}$"
     },
     "kind": {
      "enum": [
       "DIRECT",
       "INDIRECT"
      ]
     },
     "boundary": {
      "type": "string",
      "minLength": 1
     },
     "parentWindow": {
      "type": [
       "string",
       "null"
      ],
      "pattern": "^OW-[0-9]{2,3}$"
     },
     "observationCall": {
      "type": "string",
      "minLength": 1
     },
     "nestedChecks": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      }
     },
     "protectedFacts": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      },
      "minItems": 1
     },
     "tracePosition": {
      "type": "string",
      "minLength": 1
     },
     "autonomousEventLatency": {
      "type": "string",
      "minLength": 1
     },
     "obligations": {
      "type": "array",
      "items": {
       "enum": [
        "E01",
        "E02",
        "E03",
        "E04",
        "E05",
        "E06",
        "E07",
        "E08",
        "E09",
        "E10",
        "E11",
        "E12"
       ]
      },
      "minItems": 1,
      "uniqueItems": true
     },
     "tests": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      },
      "minItems": 1
     },
     "removal": {
      "type": [
       "object",
       "null"
      ],
      "additionalProperties": false,
      "required": [
       "removedOrMovedCall",
       "newTracePosition",
       "lostWindow",
       "exclusionProof",
       "stateKeepingFreshChecks"
      ],
      "properties": {
       "removedOrMovedCall": {
        "type": "string",
        "minLength": 1
       },
       "newTracePosition": {
        "type": [
         "string",
         "null"
        ],
        "minLength": 1
       },
       "lostWindow": {
        "type": "string",
        "minLength": 1
       },
       "exclusionProof": {
        "type": "string",
        "minLength": 1
       },
       "stateKeepingFreshChecks": {
        "type": "array",
        "items": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     }
    }
   },
   "minItems": 1
  }
 }
}

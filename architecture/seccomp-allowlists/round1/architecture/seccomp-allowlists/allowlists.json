{
 "defaultAction": "KILL_PROCESS",
 "mode": 2,
 "ownerDecisions": [
  {
   "date": "2026-10-09",
   "decision": "W02d defines the WORKER allowlist from the worker's duties; the W01 section 5.3 WORKER row text 'Existing worker allowlist' is amended to 'the W02d worker allowlist' (carried to W01's record)",
   "id": "W02d-Q1"
  },
  {
   "date": "2026-10-09",
   "decision": "exact duty syscalls per role from its row plus one closed runtime base per role (CPython 3.12 for SERVER and WORKER, one native static base for the five native roles); W03's language and libc must fit inside it or W02d reopens",
   "id": "W02d-Q2"
  },
  {
   "date": "2026-10-09",
   "decision": "seccompFilterDigest is the SHA-256 of the classic-BPF sock_filter array (little-endian) the reference compiler emits per role and architecture; the boot-time proof that the installed filter equals it is an open T04/W02a-F obligation",
   "id": "W02d-Q3"
  }
 ],
